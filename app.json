{
  "expo": {
    "name": "Diamond Runner",
    "slug": "diamond-runner",
    "version": "1.0.0",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "orientation": "portrait",
    "icon": "./src/assets/images/diamondlogo.jpeg",
    "scheme": "diamondrunner",
    "userInterfaceStyle": "automatic",
    "extra": {
      "eas": {
        "projectId": "e83319af-140d-451e-b52d-6d6c40539407"
      }
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logodiamond.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "output": "single"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logodiamond.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-video",
      "expo-audio"
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
